PORT=3000
DATABASE_URL=postgresql://neondb_owner:your_password_here@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Used only when DATABASE_URL is missing; also seeds the first admin row in Neon on first boot
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Required in production (Vercel) — use a long random string
JWT_SECRET=change-me-to-a-long-random-secret

# Email notifications (optional)
# Gmail example: enable 2FA, create an App Password, use smtp.gmail.com:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="BUIC Quiz <your-email@gmail.com>"

# bKash Send Money number shown on book registration (public)
BKASH_NUMBER=01XXXXXXXXX
